# ─────────────────────────────────────────────────────────────────────────────
# FERAL booking server — copy to .env (never commit .env) and fill in.
# Everything here stays on the server; none of it is sent to browsers.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8787
# Public URL of the site, no trailing slash. Used in email links, the pass QR
# and webhook signature checks. Must be https in production.
APP_URL=https://www.getferal.in
# Where the pass QR points (defaults to APP_URL/verify).
# PASS_VERIFY_URL=https://www.getferal.in/verify
# Behind a proxy/load balancer (Render, Railway, Fly, Nginx…): keep true so
# rate limits see the real client IP.
TRUST_PROXY=true

# ── Database (PostgreSQL 14+) ────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/feral
# Set true for hosted Postgres that requires TLS (Neon, Supabase, RDS…).
DATABASE_SSL=true

# ── Security ─────────────────────────────────────────────────────────────────
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out and invalidates live OTPs and email links
# (issued passes keep working only if it is NOT rotated — keep it stable).
APP_SECRET=
COOKIE_SECURE=true
ADMIN_SESSION_HOURS=12

# ── Email (OTP, payment instructions, passes, rejections) ────────────────────
# resend | smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=FERAL <tickets@getferal.in>
EMAIL_REPLY_TO=
# Resend: https://resend.com → API Keys (verify your sending domain first)
RESEND_API_KEY=
# Resend → Webhooks → endpoint APP_URL/api/webhooks/resend (events: delivered, bounced, complained)
RESEND_WEBHOOK_SECRET=
# SMTP alternative (Gmail/Workspace app password, Zoho, SES SMTP…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Email OTP ────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# ── Organizer phone alerts ───────────────────────────────────────────────────
# twilio_sms | twilio_whatsapp | whatsapp_cloud
NOTIFY_PROVIDER=whatsapp_cloud
# Organizer number(s), comma-separated, with country code. Can also be set in
# the admin (Settings → Payment & organizer alerts).
ORGANIZER_PHONE=+91XXXXXXXXXX

# WhatsApp Business Cloud API (Meta) — see docs/BOOKINGS.md for the templates
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEMPLATE=feral_payment_pending
WHATSAPP_CLOUD_TEMPLATE_REJECTED=feral_payment_rejected
WHATSAPP_CLOUD_TEMPLATE_LANG=en
# delivery-status webhook: APP_URL/api/webhooks/whatsapp
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=

# Twilio (SMS or WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_CONTENT_SID_REJECTED=

# ── Payments ─────────────────────────────────────────────────────────────────
# static_upi (your QR, verified by you) | razorpay. Can be switched in the admin.
PAYMENT_MODE=static_upi
# The payment QR (Kotak811, KHUSHAL AGARWAL, 9818241332@kotakbank) ships in
# server/assets/payment-qr.png and is installed on first start. Point this at
# another image to use that instead, or set it to "none". A QR uploaded in the
# admin always replaces it.
PAYMENT_QR_PATH=
# Razorpay (mode B) — Dashboard → Settings → API Keys / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# webhook endpoint APP_URL/api/webhooks/razorpay, events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=
# true: a verified, captured gateway payment is approved automatically.
# false (default): it waits in PAYMENT APPROVALS for a person.
GATEWAY_AUTO_APPROVE=false

# ── Retention ────────────────────────────────────────────────────────────────
# bookings that never verified their email are deleted after this many hours
RETENTION_UNVERIFIED_HOURS=48
# payment screenshots are purged this many days after the event ends
RETENTION_SCREENSHOT_DAYS_AFTER_EVENT=90

# ── Split hosting only ───────────────────────────────────────────────────────
# If the static site is hosted elsewhere, build it with VITE_API_URL=https://api.example.com
# and list the site's origin here so the browser may call the API.
CORS_ORIGINS=
# Serve dist/ from this server (default true).
SERVE_STATIC=true

# ── Site build ───────────────────────────────────────────────────────────────
# Public URL of the site (used for the OpenGraph image).
VITE_SITE_URL=https://www.getferal.in
# Leave empty when this server serves the site (recommended).
VITE_API_URL=
